{
  "name": "@izzyjs/route",
  "description": "Use your AdonisJs routes in your Inertia.js application",
  "version": "2.1.14",
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests",
    "!build/src/client/routes.d.ts",
    "!build/src/client/routes.js"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types/index.js",
    "./dev_hook": "./build/src/hooks/generate_hook.js",
    "./plugins/edge": "./build/src/plugins/edge.js",
    "./plugins/japa": "./build/src/plugins/japa.js",
    "./client": "./build/src/client/index.js",
    "./routes": "./build/src/client/routes.js",
    "./builder": "./build/src/builder.js",
    "./izzy_provider": "./build/providers/izzy_provider.js",
    "./commands": "./build/commands/main.js",
    "./izzy_middleware": "./build/src/izzy_middleware.js"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "quick:test": "tsx bin/test.ts",
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "prebuild": "npm run lint && npm run clean",
    "build": "tsc",
    "postbuild": "npm run copy:templates && npm run index:commands",
    "release": "release-it",
    "prepublishOnly": "npm run build",
    "index:commands": "adonis-kit index build/commands"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^2.1.0",
    "@japa/expect-type": "^2.0.3",
    "@japa/runner": "^3.1.1",
    "@poppinss/ts-exec": "^1.1.1",
    "@release-it/conventional-changelog": "^10.0.4",
    "@tuyau/utils": "^0.0.2",
    "@types/node": "^20.11.25",
    "c8": "^9.1.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^5.1.0",
    "eslint": "^10.0.3",
    "prettier": "^3.2.5",
    "release-it": "^19.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.2"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.1",
    "edge.js": "^6.5.0"
  },
  "author": "Walaff Fernandes",
  "license": "MIT",
  "homepage": "https://github.com/izzyjs/route#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izzyjs/route.git"
  },
  "bugs": {
    "url": "https://github.com/izzyjs/route/issues"
  },
  "keywords": [
    "adonis",
    "adonisjs",
    "inertiajs",
    "ziggy",
    "route",
    "generator",
    "typescript"
  ],
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  }
}
